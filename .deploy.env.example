# ==============================================================================
# AI MedStudio – Konfigurace SSH nasazení (.deploy.env)
# ==============================================================================
# Zkopírujte tento soubor jako .deploy.env a upravte dle potřeby:
#   cp .deploy.env.example .deploy.env
#
# Soubor .deploy.env je v .gitignore, takže vaše privátní IP a nastavení
# se nedostanou do GitHub repozitáře.
# ==============================================================================

# Uživatel na Raspberry Pi (výchozí: pi)
PI_USER="pi"

# Adresa nebo hostname Raspberry Pi (výchozí: malina nebo malina.local)
# Můžete zadat i přímou IP adresu, např: 192.168.1.50
PI_HOST="malina"

# Cílová složka na Raspberry Pi v rámci vaší /srv struktury (výchozí: /srv/compose/podcast)
PI_DIR="/srv/compose/podcast"

# Port aplikace (výchozí: 8000)
PI_PORT="8000"

# SSH port (výchozí: 22)
SSH_PORT="22"
