# ==============================================================================
# AI MedStudio – Proměnné prostředí
# ==============================================================================
# Zkopírujte tento soubor jako .env a vložte své API klíče:
#   cp .env.example .env
#
# Alternativně můžete klíče zadat přímo v rozhraní aplikace (BYOK).
# ==============================================================================

# Google Gemini API klíč (povinný pro základní funkce)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API klíč (volitelný – pro TTS generování audio)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API klíč (volitelný – alternativní TTS poskytovatel)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
