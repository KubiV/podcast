# ==============================================================================
# AI MedStudio – Proměnné prostředí
# ==============================================================================
# Zkopírujte tento soubor jako .env a vložte své API klíče:
#   cp .env.example .env
#
# Alternativně můžete klíče zadat přímo v rozhraní aplikace (BYOK).
# Zakomentované proměnné jsou volitelné; bez nich platí uvedená výchozí hodnota.
#
# Docker: do kontejneru se předávají jen proměnné uvedené v docker-compose.yml (sekce environment).
# Soubor .env vedle docker-compose.yml slouží compose pro dosazení ${...} – typicky
# MEDSTUDIO_BIND_ADDRESS a FORWARDED_ALLOW_IPS. Ostatní proměnné je pro Docker nutné přidat do environment.
# ==============================================================================

# --- API klíče (BYOK) ----------------------------------------------------------

# Google Gemini API klíč (povinný pro základní funkce)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API klíč (volitelný – pro TTS generování audio)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API klíč (volitelný – alternativní TTS poskytovatel)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- Server ---------------------------------------------------------------------

# Adresa a port pro spuštění přes `python main.py` (Docker používá vlastní CMD a port 8000)
# HOST=127.0.0.1
# PORT=8000

# Složka s daty (projekty, databáze, výstupy). Výchozí: kořen repozitáře, v zabalené aplikaci ~/Documents/AIMedStudio
# AIMEDSTUDIO_DATA_DIR=/cesta/k/datum

# Zastaralé: sdílené heslo pro HTTP Basic Auth (přihlásí jako admin). Doporučeno používat uživatelské účty.
# APP_PASSWORD=

# --- Limity ---------------------------------------------------------------------

# Maximální velikost jednoho nahrávaného souboru (MB)
# AIMEDSTUDIO_MAX_UPLOAD_MB=200

# Maximální velikost importovaného balíčku .medproj – komprimovaný / rozbalený obsah (MB)
# AIMEDSTUDIO_MAX_IMPORT_MB=2048
# AIMEDSTUDIO_MAX_IMPORT_UNCOMPRESSED_MB=4096

# Modely Gemini, které smí volit běžní uživatelé při sdílených API klíčích serveru (čárkami oddělený seznam).
# Admin a uživatelé s vlastním klíčem mohou zadat libovolný model.
# AIMEDSTUDIO_ALLOWED_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest,gemini-pro-latest

# --- Docker / reverzní proxy ----------------------------------------------------

# Na jaké adrese publikovat port 8000 (docker-compose). 0.0.0.0 = dostupné z LAN, 127.0.0.1 = jen ze serveru.
# MEDSTUDIO_BIND_ADDRESS=0.0.0.0

# Od kterých adres věřit hlavičkám X-Forwarded-For/Proto (reverzní proxy, CIDR čárkami). Výchozí: Docker sítě.
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- Desktopová aplikace ------------------------------------------------------

# URL vzdáleného serveru, ke kterému se má desktopová aplikace připojit místo lokálního serveru
# AIMEDSTUDIO_SERVER_URL=http://nas.local:8000
